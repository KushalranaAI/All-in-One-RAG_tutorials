{
  "name": "rag-in-30-days-web",
  "version": "1.0.0",
  "private": true,
  "author": "Kushal Rana (https://kushalranaai.github.io/)",
  "description": "Local interactive learning app for the All-in-One RAG tutorials (30 days + 15 projects)",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "check:toolkit": "node scripts/check-toolkit-snippets.mjs",
    "verify": "npm test && npm run typecheck && npm run build",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "gray-matter": "4.0.3",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
